# Build artifacts (per-backend out/ trees) — never committed.
*/out/

# Python generator caches.
tools/__pycache__/

# Transient test reports.  speed.txt / profiling.txt may be committed later as
# evidence (P14 decides); everything else under test/ that is generated stays
# out of the tree.
test/*.txt
*/test/*.txt

# Local explore/scratch output.
ref/explore/*.log

# CT-scan / dudect / bench intermediate objects & artifacts (regenerable).
*/test/.ct_scan_objs/
test/.ct_scan_objs/
*.o
*.a
massif.out*
*.massif
