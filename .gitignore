# Build artifacts (per-backend out/ trees) — never committed.
*/out/

# Python generator caches (any depth: tools/, tools/ntt/, ...).
__pycache__/

# Local explore/scratch output.
ref/explore/*.log

# CT-scan / dudect / bench intermediate objects & artifacts (regenerable).
*/test/.ct_scan_objs/
test/.ct_scan_objs/
*.o
*.a
massif.out*
*.massif

# Packaged NGCC submission tree (regenerable via pack_ngcc.sh).
dist/

