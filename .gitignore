test/diff_fuzz_matrix.txt
test/integration_audit_matrix.txt
test/leak_audit.txt
test/perf_review_checklist_status.txt

# bulk-K derivation intermediates; the script + bulk_k.log are committed.
tools/gen_bulk_k/hist_*.txt
